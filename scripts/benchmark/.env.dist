# Copy to `.env` (git-ignored) and fill in. Read by lib/config.R; never printed,
# never committed. Values are literal (no shell evaluation); inline ' # comments'
# are stripped. Connection keys are required only for the backends you list in
# BACKENDS x LOCATIONS -- a missing one fails loudly. All backends use basic auth.

# --- Backends to run --------------------------------------------------------
# Two axes, listed once each. BACKENDS: the engines (opal, armadillo_rock,
# armadillo_rserve). LOCATIONS: local and/or remote. Every engine runs at every
# location; trim either list to the subset you can reach.
BACKENDS=opal,armadillo_rock,armadillo_rserve
LOCATIONS=local,remote

# --- Local servers ---------------------------------------------------------
# The *_local servers run on localhost at these ports; start_servers.sh binds them
# and the client connects to them. Versions/images are only for start_servers.sh
# (remote servers run whatever they run). OPAL_ROCK_VERSION pins Opal's R engine;
# RSERVE_IMAGE/RSERVE_PORT are the local Armadillo 'rserve' profile setup.R adds
# (the 'default' profile ships with Armadillo, on port 6311).
IMAGE=datashield/rserver_soccer-donkey:latest
RSERVE_PORT=6315

# --- Opal -------------------------------------------------------------------
OPAL_LOCAL_USER=administrator
OPAL_LOCAL_PASS=

OPAL_REMOTE_URL=https://opal.example.org
OPAL_REMOTE_USER=administrator
OPAL_REMOTE_PASS=

# --- Armadillo (user + password) --------------------------------------------
ARMA_LOCAL_USER=admin
ARMA_LOCAL_PASS=admin

ARMA_REMOTE_URL=https://armadillo.example.org
ARMA_REMOTE_USER=admin
ARMA_REMOTE_PASS=

Datashield profiles
# Profile names. For the local Armadillo, setup.R creates+starts the 'rserve'
# profile on $RSERVE_IMAGE (the 'default' profile ships with Armadillo); on remote
# servers all profiles must already exist (see README "Armadillo profiles").
OPAL_PROFILE=default          # Opal rock
ARMA_PROFILE=default          # Armadillo rock
ARMA_RSERVE_PROFILE=rserver   # Armadillo rserve

# --- Upload destination -----------------------------------------------------
# Where setup.R uploads the tables (Opal project / Armadillo project + folder).
PROJECT=perf
FOLDER=bench

# --- Run parameters --------------------------------------------------------
# (Benchmark data is vendored and fixed at 10,000 rows -- no size knobs.)
# Fair interleaving: SPEED_SETS shuffled passes x SPEED_REPS reps/pass per ce
SPEED_REPS=4
SPEED_SETS=5
SEED=1
# Poll interval (s) between "is it done?" checks; held tight so it doesn't distort timing.
POLL_SLEEP=0.002
